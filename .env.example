# Plantilla de variables de entorno. Copiar a .env y completar valores reales.
# .env está en .gitignore — NUNCA commitear credenciales reales.
MYSQL_ROOT_PASSWORD=
DB_HOST=db
DB_NAME=web_samap
DB_USER=
DB_PASS=

# SMTP — formulario de contacto (enviar.php)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=web@samap.com.py
LEADS_TO=asistente.ventas1@samap.com.py
LEADS_BCC=

# Encriptacion PII de tbl_leads (Ley 6534/20 - Paraguay).
# AES-256-GCM: 32 bytes hex (64 chars). Generar con:
#   docker exec samap-web php -r "echo bin2hex(random_bytes(32));"
# Sin esta clave, las inserciones nuevas en tbl_leads fallan con
# RuntimeException al intentar encriptar. Mantener el mismo valor entre
# despliegues (si se cambia, las filas encriptadas con la clave vieja
# quedan ilegibles).
LEAD_ENC_KEY=
